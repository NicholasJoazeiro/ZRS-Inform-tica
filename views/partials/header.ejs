<!DOCTYPE html>
<html lang="pt-br" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              cyber: {
                bg: '#030712',
                card: 'rgba(15, 23, 42, 0.65)',
                cyan: '#00f0ff',
                cyanGlow: '#06b6d4',
                blue: '#3b82f6',
                red: '#e11d48',
                slate: '#0f172a'
              }
            },
            fontFamily: {
              heading: ['Outfit', 'sans-serif'],
              body: ['Inter', 'sans-serif']
            }
          }
        }
      }
    </script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="<%= basePath %>/assets/css/style.css">
    <meta name="description" content="Segurança, Estabilidade e Inteligência em TI para o Vale do Sinos. 25 anos de expertise em infraestrutura, redes e consultoria.">
    <link rel="icon" type="image/png" href="<%= basePath %>/assets/images/icone.png">
</head>
<body class="bg-[#030712] text-slate-100 antialiased selection:bg-cyan-500 selection:text-black">

<header class="main-header fixed top-0 left-0 w-full z-50 transition-all duration-300 border-b border-white/10 bg-[#030712]/80 backdrop-blur-xl">
    <div class="container mx-auto px-4 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Logo -->
        <a href="<%= basePath %>/index.html" class="flex items-center gap-3 group">
            <img src="<%= basePath %>/assets/images/logozrs.png" alt="ZRS Informática Logo" class="h-11 w-auto transition-transform duration-300 group-hover:scale-105 filter drop-shadow-[0_0_12px_rgba(0,240,255,0.25)]">
        </a>
        
        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-8">
            <a href="<%= basePath %>/index.html" class="nav-link font-heading font-medium text-sm text-slate-300 hover:text-cyan-400 transition-colors duration-200 relative py-1">
                Home
            </a>
            <a href="<%= basePath %>/servicos.html" class="nav-link font-heading font-medium text-sm text-slate-300 hover:text-cyan-400 transition-colors duration-200 relative py-1">
                Serviços
            </a>
            <a href="<%= basePath %>/sobre.html" class="nav-link font-heading font-medium text-sm text-slate-300 hover:text-cyan-400 transition-colors duration-200 relative py-1">
                Quem Somos
            </a>
            <a href="<%= basePath %>/suporte.html" class="nav-link font-heading font-medium text-sm text-slate-300 hover:text-cyan-400 transition-colors duration-200 relative py-1">
                Suporte
            </a>
            <a href="<%= basePath %>/blog.html" class="nav-link font-heading font-medium text-sm text-slate-300 hover:text-cyan-400 transition-colors duration-200 relative py-1">
                Blog
            </a>
        </nav>
        
        <!-- Actions -->
        <div class="hidden md:flex items-center gap-4">
            <a href="https://wa.me/5551994374526" target="_blank" class="btn btn-primary text-xs py-2.5 px-5 rounded-lg flex items-center gap-2">
                <span>Falar com Especialista</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </div>

        <!-- Mobile Toggle Button -->
        <button id="mobile-toggle" aria-label="Abrir Menu" class="md:hidden flex flex-col justify-center gap-1.5 w-10 h-10 p-2 rounded-lg bg-slate-900/80 border border-white/10 text-slate-200 focus:outline-none">
            <span class="bar transition-all duration-300 w-full h-0.5 bg-cyan-400 rounded-full"></span>
            <span class="bar transition-all duration-300 w-full h-0.5 bg-slate-200 rounded-full"></span>
            <span class="bar transition-all duration-300 w-full h-0.5 bg-cyan-400 rounded-full"></span>
        </button>
    </div>

    <!-- Mobile Drawer Nav -->
    <div id="mobile-menu" class="hidden md:hidden bg-[#030712]/95 backdrop-blur-2xl border-b border-cyan-500/20 px-6 py-6 transition-all duration-300">
        <nav class="flex flex-col gap-4">
            <a href="<%= basePath %>/index.html" class="mobile-nav-item py-3 px-4 rounded-xl text-base font-heading font-semibold text-slate-200 hover:bg-cyan-500/10 hover:text-cyan-400 transition-all border border-transparent hover:border-cyan-500/20">
                Home
            </a>
            <a href="<%= basePath %>/servicos.html" class="mobile-nav-item py-3 px-4 rounded-xl text-base font-heading font-semibold text-slate-200 hover:bg-cyan-500/10 hover:text-cyan-400 transition-all border border-transparent hover:border-cyan-500/20">
                Serviços
            </a>
            <a href="<%= basePath %>/sobre.html" class="mobile-nav-item py-3 px-4 rounded-xl text-base font-heading font-semibold text-slate-200 hover:bg-cyan-500/10 hover:text-cyan-400 transition-all border border-transparent hover:border-cyan-500/20">
                Quem Somos
            </a>
            <a href="<%= basePath %>/suporte.html" class="mobile-nav-item py-3 px-4 rounded-xl text-base font-heading font-semibold text-slate-200 hover:bg-cyan-500/10 hover:text-cyan-400 transition-all border border-transparent hover:border-cyan-500/20">
                Suporte
            </a>
            <a href="<%= basePath %>/blog.html" class="mobile-nav-item py-3 px-4 rounded-xl text-base font-heading font-semibold text-slate-200 hover:bg-cyan-500/10 hover:text-cyan-400 transition-all border border-transparent hover:border-cyan-500/20">
                Blog
            </a>
            <div class="pt-4 border-t border-white/10 mt-2">
                <a href="https://wa.me/5551994374526" target="_blank" class="btn btn-primary w-full text-center justify-center py-3">
                    Falar com Especialista
                </a>
            </div>
        </nav>
    </div>
</header>

<style>
.main-header.scrolled {
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    background-color: rgba(3, 7, 18, 0.95);
    box-shadow: 0 10px 30px -10px rgba(0, 240, 255, 0.15);
}

.mobile-toggle.active .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
}
.mobile-toggle.active .bar:nth-child(2) {
    opacity: 0;
}
.mobile-toggle.active .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
}
</style>
