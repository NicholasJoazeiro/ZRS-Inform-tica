<%- include('../partials/header') %>

<main class="relative overflow-hidden bg-[#030712]">

    <!-- HERO SECTION -->
    <section class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-16 tech-grid-bg overflow-hidden">
        <!-- Ambient Glow Orbs -->
        <div class="glow-orb glow-orb-cyan top-1/4 -left-24 opacity-60"></div>
        <div class="glow-orb glow-orb-blue bottom-10 -right-24 opacity-60"></div>
        
        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            <div class="max-w-4xl mx-auto text-center space-y-8 reveal">
                
                <!-- Authority Badge -->
                <div class="inline-flex items-center">
                    <span class="tech-badge">
                        <span class="tech-badge-dot"></span>
                        <span>25 Anos de Tradição e Inovação no Vale do Sinos</span>
                    </span>
                </div>

                <!-- Main Headline -->
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-slate-100 tracking-tight leading-[1.15]">
                    Segurança, Estabilidade e <br class="hidden sm:inline">
                    <span class="text-gradient-cyan">Inteligência em TI</span> para o Seu Negócio
                </h1>

                <!-- Subtitle -->
                <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
                    Transformamos infraestrutura de tecnologia em vantagem competitiva proativa com foco em continuidade operacional e blindagem de dados.
                </p>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                    <a href="#diagnostico" class="btn btn-primary w-full sm:w-auto text-base py-4 px-8">
                        <span>Solicitar Diagnóstico Gratuito</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                    <a href="<%= basePath %>/servicos.html" class="btn btn-outline w-full sm:w-auto text-base py-4 px-8">
                        <span>Conhecer Nossos Serviços</span>
                    </a>
                </div>

                <!-- Feature Pills -->
                <div class="pt-10 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto text-left">
                    <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/50 border border-white/5 backdrop-blur-md">
                        <span class="text-xl">🛡️</span>
                        <span class="text-xs font-medium text-slate-300">Proteção Anti-Ransomware</span>
                    </div>
                    <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/50 border border-white/5 backdrop-blur-md">
                        <span class="text-xl">⚡</span>
                        <span class="text-xs font-medium text-slate-300">Atendimento SLA Rápido</span>
                    </div>
                    <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/50 border border-white/5 backdrop-blur-md">
                        <span class="text-xl">🔒</span>
                        <span class="text-xs font-medium text-slate-300">Conformidade LGPD</span>
                    </div>
                    <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/50 border border-white/5 backdrop-blur-md">
                        <span class="text-xl">🌐</span>
                        <span class="text-xs font-medium text-slate-300">Monitoramento 24/7</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- AUTHORITY COUNTER SECTION -->
    <section class="counter-section py-16 bg-slate-950/80 border-y border-white/10 relative">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="grid grid-cols-2 lg:grid-cols-5 gap-6 text-center">
                
                <div class="glass-card bg-slate-900/40 p-6 rounded-2xl border border-white/5 hover:border-cyan-500/30 transition-all">
                    <div class="flex items-baseline justify-center">
                        <span class="counter-number text-4xl sm:text-5xl font-heading font-extrabold text-gradient-cyan" data-target="25">0</span>
                        <span class="text-2xl font-bold text-cyan-400 ml-1">+</span>
                    </div>
                    <span class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mt-2">Anos de Expertise</span>
                </div>

                <div class="glass-card bg-slate-900/40 p-6 rounded-2xl border border-white/5 hover:border-cyan-500/30 transition-all">
                    <div class="flex items-baseline justify-center">
                        <span class="counter-number text-4xl sm:text-5xl font-heading font-extrabold text-gradient-cyan" data-target="100">0</span>
                        <span class="text-2xl font-bold text-cyan-400 ml-1">+</span>
                    </div>
                    <span class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mt-2">Clientes Ativos</span>
                </div>

                <div class="glass-card bg-slate-900/40 p-6 rounded-2xl border border-white/5 hover:border-cyan-500/30 transition-all">
                    <div class="flex items-baseline justify-center">
                        <span class="counter-number text-4xl sm:text-5xl font-heading font-extrabold text-gradient-cyan" data-target="2000">0</span>
                        <span class="text-2xl font-bold text-cyan-400 ml-1">+</span>
                    </div>
                    <span class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mt-2">Usuários Protegidos</span>
                </div>

                <div class="glass-card bg-slate-900/40 p-6 rounded-2xl border border-white/5 hover:border-cyan-500/30 transition-all">
                    <div class="flex items-baseline justify-center">
                        <span class="counter-number text-4xl sm:text-5xl font-heading font-extrabold text-gradient-cyan" data-target="100">0</span>
                        <span class="text-2xl font-bold text-cyan-400 ml-1">%</span>
                    </div>
                    <span class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mt-2">Segurança em Nuvem</span>
                </div>

                <div class="glass-card bg-slate-900/40 p-6 rounded-2xl border border-white/5 hover:border-cyan-500/30 transition-all col-span-2 lg:col-span-1">
                    <div class="flex items-baseline justify-center">
                        <span class="counter-number text-4xl sm:text-5xl font-heading font-extrabold text-gradient-cyan" data-target="24">0</span>
                        <span class="text-2xl font-bold text-cyan-400 ml-1">/7</span>
                    </div>
                    <span class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mt-2">Monitoramento NOC</span>
                </div>

            </div>
        </div>
    </section>

    <!-- VALUE TRIAD SECTION -->
    <section class="py-24 relative">
        <div class="glow-orb glow-orb-cyan top-1/3 left-10 opacity-30"></div>

        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            
            <div class="text-center max-w-3xl mx-auto mb-16 reveal">
                <h2 class="section-title text-gradient-cyan">Tríade de Valor ZRS</h2>
                <p class="section-subtitle">
                    Fundamentamos nossa governança em três pilares estratégicos para garantir alta disponibilidade e proteção contínua.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- Pillar 1 -->
                <div class="glass-card glass-card-glow reveal group">
                    <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 group-hover:bg-cyan-500/20 transition-all duration-300 shadow-[0_0_20px_rgba(0,240,255,0.15)]">
                        🛡️
                    </div>
                    <h3 class="text-2xl font-heading font-bold text-slate-100 mb-3 group-hover:text-cyan-300 transition-colors">
                        Segurança de Redes
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Ambientes corporativos blindados com Firewalls de Nova Geração (NGFW), inspeção profunda de pacotes e mitigação proativa de ameaças em tempo real.
                    </p>
                </div>

                <!-- Pillar 2 -->
                <div class="glass-card glass-card-glow reveal group">
                    <div class="w-16 h-16 rounded-2xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 group-hover:bg-blue-500/20 transition-all duration-300 shadow-[0_0_20px_rgba(59,130,246,0.15)]">
                        🧠
                    </div>
                    <h3 class="text-2xl font-heading font-bold text-slate-100 mb-3 group-hover:text-blue-300 transition-colors">
                        Consultoria Estratégica
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Planejamento de arquitetura de TI escalável que transforma a tecnologia em vetor de crescimento, eliminando custos com gargalos técnicos.
                    </p>
                </div>

                <!-- Pillar 3 -->
                <div class="glass-card glass-card-glow reveal group">
                    <div class="w-16 h-16 rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 group-hover:bg-rose-500/20 transition-all duration-300 shadow-[0_0_20px_rgba(225,29,72,0.15)]">
                        🚀
                    </div>
                    <h3 class="text-2xl font-heading font-bold text-slate-100 mb-3 group-hover:text-rose-300 transition-colors">
                        Suporte Especializado
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Atendimento com SLA ágil e corpo técnico dedicado, focado em resolver ocorrências sem causar paradas na sua operação diária.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- ROI & IMPACT SECTION -->
    <section class="py-20 bg-slate-950/60 border-y border-white/5 relative">
        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <div class="lg:col-span-7 space-y-6 reveal">
                    <span class="tech-badge">Retorno Sobre Investimento</span>
                    <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-100">
                        O Impacto Real de uma <span class="text-gradient-cyan">TI Gerenciada</span>
                    </h2>
                    <p class="text-slate-300 text-base leading-relaxed">
                        Não somos um centro de custos — somos parceiros na aceleração do seu negócio. Empresas que migram para nosso modelo preventivo registram:
                    </p>
                    
                    <ul class="space-y-4 pt-2">
                        <li class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">✓</span>
                            <div>
                                <strong class="text-slate-100">Até 30% de redução de custos operacionais:</strong>
                                <span class="text-slate-400 text-sm block">Eliminação de paradas desnecessárias e retrabalho de equipe.</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">✓</span>
                            <div>
                                <strong class="text-slate-100">Zero Inatividade Crítica:</strong>
                                <span class="text-slate-400 text-sm block">Planos de contingência e backups imutáveis redundantes.</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">✓</span>
                            <div>
                                <strong class="text-slate-100">Conformidade Total com LGPD:</strong>
                                <span class="text-slate-400 text-sm block">Blindagem jurídica e técnica contra vazamento de dados confidenciais.</span>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="lg:col-span-5 reveal">
                    <div class="glass-card bg-slate-900/80 border-cyan-500/30 p-8 text-center space-y-4 relative overflow-hidden shadow-[0_0_50px_rgba(6,182,212,0.15)]">
                        <div class="glow-orb glow-orb-cyan -top-20 -right-20 opacity-40"></div>
                        <span class="text-xs uppercase font-heading font-semibold text-cyan-400 tracking-wider">Média de Economia</span>
                        <div class="text-6xl sm:text-7xl font-heading font-black text-gradient-cyan leading-none">
                            30%
                        </div>
                        <div class="text-sm font-medium text-slate-300">
                            Otimização no Custo Total de Propriedade (TCO) de Tecnologia
                        </div>
                        <div class="pt-4">
                            <a href="#diagnostico" class="btn btn-primary w-full text-sm py-3">
                                Calcular para Minha Empresa
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- METHODOLOGY SECTION -->
    <section class="py-24 relative">
        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            
            <div class="text-center max-w-3xl mx-auto mb-16 reveal">
                <h2 class="section-title text-gradient-cyan">Nossa Metodologia de Gestão</h2>
                <p class="section-subtitle">
                    Um fluxo contínuo de 4 etapas desenhado para garantir previsibilidade, segurança e máxima performance.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                
                <!-- Step 01 -->
                <div class="glass-card bg-slate-900/50 p-6 rounded-2xl border border-white/10 hover:border-cyan-500/40 hover:-translate-y-2 transition-all duration-300 reveal group">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-3xl">🔍</span>
                        <span class="text-3xl font-heading font-black text-slate-700 group-hover:text-cyan-400 transition-colors">01</span>
                    </div>
                    <h4 class="text-xl font-heading font-bold text-slate-100 mb-2">Avaliação</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">
                        Diagnóstico completo da infraestrutura, mapeando riscos de segurança e gargalos de velocidade.
                    </p>
                </div>

                <!-- Step 02 -->
                <div class="glass-card bg-slate-900/50 p-6 rounded-2xl border border-white/10 hover:border-cyan-500/40 hover:-translate-y-2 transition-all duration-300 reveal group">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-3xl">📐</span>
                        <span class="text-3xl font-heading font-black text-slate-700 group-hover:text-cyan-400 transition-colors">02</span>
                    </div>
                    <h4 class="text-xl font-heading font-bold text-slate-100 mb-2">Planejamento</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">
                        Desenho da arquitetura de solução sob medida com priorização de dados críticos.
                    </p>
                </div>

                <!-- Step 03 -->
                <div class="glass-card bg-slate-900/50 p-6 rounded-2xl border border-white/10 hover:border-cyan-500/40 hover:-translate-y-2 transition-all duration-300 reveal group">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-3xl">⚙️</span>
                        <span class="text-3xl font-heading font-black text-slate-700 group-hover:text-cyan-400 transition-colors">03</span>
                    </div>
                    <h4 class="text-xl font-heading font-bold text-slate-100 mb-2">Implementação</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">
                        Execução técnica especializada com foco em zero paralisação operacional (zero downtime).
                    </p>
                </div>

                <!-- Step 04 -->
                <div class="glass-card bg-slate-900/50 p-6 rounded-2xl border border-white/10 hover:border-cyan-500/40 hover:-translate-y-2 transition-all duration-300 reveal group">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-3xl">📈</span>
                        <span class="text-3xl font-heading font-black text-slate-700 group-hover:text-cyan-400 transition-colors">04</span>
                    </div>
                    <h4 class="text-xl font-heading font-bold text-slate-100 mb-2">Gestão Contínua</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">
                        Monitoramento 24/7, relatórios periódicos e atualizações contínuas de segurança.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- BLOG PREVIEW SECTION -->
    <section class="py-20 bg-slate-950/40 border-t border-white/5">
        <div class="container mx-auto px-4 lg:px-8">
            
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 reveal">
                <div>
                    <span class="tech-badge mb-3">Conhecimento Técnico</span>
                    <h2 class="section-title text-left text-gradient-cyan mb-0">Artigos e Novidades</h2>
                </div>
                <a href="<%= basePath %>/blog.html" class="btn btn-outline text-xs py-2.5 px-5 mt-4 md:mt-0">
                    Ver Todos os Artigos →
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <% if(typeof blogs !== 'undefined' && blogs.length > 0) { %>
                    <% blogs.forEach(post => { %>
                        <div class="glass-card bg-slate-900/50 p-6 rounded-2xl border border-white/10 flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300 reveal">
                            <div>
                                <span class="text-xs font-semibold text-cyan-400 block mb-2"><%= post.date %></span>
                                <h3 class="text-lg font-heading font-bold text-slate-100 mb-3 line-clamp-2 hover:text-cyan-300 transition-colors">
                                    <%= post.title %>
                                </h3>
                                <p class="text-slate-400 text-xs leading-relaxed line-clamp-3 mb-6">
                                    <%= post.excerpt %>
                                </p>
                            </div>
                            <a href="<%= basePath %>/blog/<%= post.slug %>.html" class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors pt-4 border-t border-white/5">
                                <span>Ler artigo completo</span>
                                <span>→</span>
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-slate-400 text-center col-span-3">Nenhum artigo disponível no momento.</p>
                <% } %>
            </div>

        </div>
    </section>

    <!-- FINAL CTA SECTION -->
    <section id="diagnostico" class="py-24 relative overflow-hidden">
        <div class="glow-orb glow-orb-cyan top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-40"></div>
        
        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            <div class="glass-card bg-slate-900/90 border-cyan-500/40 p-10 sm:p-16 rounded-3xl text-center max-w-4xl mx-auto space-y-6 shadow-[0_0_60px_rgba(6,182,212,0.2)] reveal">
                <span class="tech-badge">Diagnóstico Gratuito</span>
                <h2 class="text-3xl sm:text-5xl font-heading font-extrabold text-slate-100 leading-tight">
                    Pronto para Elevar o Nível da Sua TI?
                </h2>
                <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto">
                    Garanta a estabilidade e proteção que seu negócio necessita. Agende uma consultoria sem compromisso com nossos especialistas.
                </p>
                <div class="pt-4 flex justify-center">
                    <a href="https://wa.me/5551994374526" target="_blank" class="btn btn-primary text-base py-4 px-10">
                        <span>Falar com Consultor Agora</span>
                        <span class="text-xl">💬</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

</main>

<%- include('../partials/footer') %>
